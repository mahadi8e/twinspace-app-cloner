<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">



    <PreferenceCategory app:title="@string/other">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>



        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

        <SwitchPreferenceCompat
                app:key="use_vpn_network"
                app:title="@string/use_vpn_network"
                app:summary="@string/use_vpn_network_summary" />

        <Preference
                android:key="vpn_status"
                android:title="@string/vpn_status"
                android:summary="@string/vpn_status_off" />

        <Preference
                android:key="vpn_config"
                android:title="@string/vpn_config"
                android:summary="@string/vpn_config_summary" />

        <Preference
                android:key="fake_location"
                android:title="@string/fake_location_setting"
                android:summary="@string/fake_location_summary" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />

        <!-- TwinSpace, 2026-11-28: debug-only. SettingFragment hides
             this when BuildConfig.DEBUG is false, so the release APK
             never shows it. -->
        <Preference
                android:key="export_log"
                android:title="@string/export_log"
                android:summary="@string/export_log_summary" />

        <!-- TwinSpace, 2026-11-28: "Clear log". Md asked for it:
             the exported log file keeps growing (the crash buffer
             holds hours of old crashes) and a big file is hard to
             upload. Tapping it wipes the log buffer and deletes the
             previously exported files, so the next export is small. -->
        <Preference
                android:key="clear_log"
                android:title="@string/clear_log"
                android:summary="@string/clear_log_summary" />

    </PreferenceCategory>

</PreferenceScreen>